{
  "name": "vagrant-studio",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @vagrant-studio/desktop tauri dev",
    "build": "pnpm --filter @vagrant-studio/desktop tauri build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check"
  }
}
