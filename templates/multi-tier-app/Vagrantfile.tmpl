Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"

  config.vm.define "proxy", primary: true do |proxy|
    proxy.vm.hostname = "proxy"
    proxy.vm.network "private_network", ip: "192.168.56.20"
    proxy.vm.network "forwarded_port", guest: 80, host: 8081, host_ip: "127.0.0.1"
    {{provider target=proxy cpus=1 memory=512}}
    proxy.vm.provision "shell", inline: <<-SHELL
      apt-get update -y
      apt-get install -y nginx
    SHELL
  end

  config.vm.define "app" do |app|
    app.vm.hostname = "app"
    app.vm.network "private_network", ip: "192.168.56.21"
    {{provider target=app cpus=2 memory=2048}}
    app.vm.provision "shell", inline: <<-SHELL
      apt-get update -y
      apt-get install -y build-essential git curl
    SHELL
  end

  config.vm.define "db" do |db|
    db.vm.hostname = "db"
    db.vm.network "private_network", ip: "192.168.56.22"
    {{provider target=db cpus=1 memory=1024}}
    db.vm.provision "shell", inline: <<-SHELL
      apt-get update -y
      apt-get install -y postgresql
    SHELL
  end
end
